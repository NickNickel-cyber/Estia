{
  "manifest_version": 3,
  "name": "Focus Planner",
  "version": "1.2.0",
  "description": "Plan your task, open the apps you need, and start a focus timer with calming background sounds.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Focus Planner",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "notifications",
    "tabs",
    "tabGroups",
    "favicon"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open Focus Planner"
    }
  },
  "minimum_chrome_version": "116",
  "incognito": "spanning"
}
